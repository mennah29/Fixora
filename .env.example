# =============================================================================
# Fixora Environment Configuration
# Copy this file to .env and set your API keys. Do not commit .env to GitHub.
# =============================================================================

ENVIRONMENT=production
API_KEY=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Persisted data paths
DATA_DIR=data
CHUNKS_FILE=all_device_fault_chunks.json
CHROMA_DIR=chroma
COLLECTION_NAME=device_fault_chunks
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_LOCAL_FILES_ONLY=false
AUTO_INDEX=false
TOP_K=5
MIN_SEMANTIC_SCORE=0.30

# =============================================================================
# LLM Providers (Select one: groq, openai, anthropic, ollama, extractive)
# =============================================================================
LLM_PROVIDER=groq

# Groq (Recommended - High Speed Inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Web Search Fallback
TAVILY_API_KEY=

# Audio Configuration
AUDIO_STT_PROVIDER=disabled
AUDIO_TTS_PROVIDER=disabled
